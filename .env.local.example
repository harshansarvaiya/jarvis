# ==========================================
# J.A.R.V.I.S. Core Environment Configuration
# ==========================================

# 1. Google Gemini API Key (Required for conversational intelligence & reasoning)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=

# 2. Guardian Security Gate Master Passcode (Required for Face ID & PIN unlock)
JARVIS_MASTER_PIN=1010

# 3. Cloud 24/7 Edge Uplink (Optional - Upstash Redis REST)
# Free 24/7 cloud persistence for Vercel/multi-device deployment (https://upstash.com)
# When set, J.A.R.V.I.S. automatically syncs tasks & chats across all devices 24/7 even if PC is off.
# If omitted, J.A.R.V.I.S. seamlessly falls back to local disk storage.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 4. Independent Sovereign Engines (Free Tier - Zero Google Lock-In)
# Groq Cloud (Meta Llama 3.3 70B & 8B on custom US LPU silicon - Free at https://console.groq.com/keys)
GROQ_API_KEY=

# GitHub Models (OpenAI GPT-4o & GPT-4o-mini - Free at https://github.com/settings/tokens)
GITHUB_TOKEN=

# 5. Optional: Default Model (gemini-3.8-flash, llama-3.3-70b-versatile, gpt-4o)
NEXT_PUBLIC_DEFAULT_MODEL=gemini-3.8-flash

# 6. Local Tunnel Configuration (Optional - for ./start-jarvis.ps1 -Global)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

